<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= titulo %> | EcoPulso</title>

    <!-- Bootstrap local -->
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.css">

    <!-- Estilos de EcoPulso -->
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>

    <!-- =====================================
         MENÚ PRINCIPAL DE ECOPULSO
    ===================================== -->
    <nav class="navbar navbar-expand-lg navbar-dark ecopulso-navbar sticky-top">
        <div class="container">

            <!-- Marca -->
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-globe-americas me-2"></i>
                EcoPulso
            </a>

            <!-- Menú móvil -->
            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menuPrincipal"
                aria-controls="menuPrincipal"
                aria-expanded="false"
                aria-label="Abrir menú"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navegación -->
            <div class="collapse navbar-collapse justify-content-end" id="menuPrincipal">
                <div class="navbar-nav align-items-lg-center">

                    <!-- Secciones públicas -->
                    <a class="nav-link <%= paginaactual === 'inicio' ? 'active' : '' %>" href="/">
                        Inicio
                    </a>

                    <a class="nav-link <%= paginaactual === 'ecomapa' ? 'active' : '' %>" href="/ecomapa">
                        EcoMapa
                    </a>

                    <a class="nav-link <%= paginaactual === 'ecojornadas' ? 'active' : '' %>" href="/ecojornadas">
                        EcoJornadas
                    </a>

                    <a class="nav-link <%= paginaactual === 'proposito' ? 'active' : '' %>" href="/proposito">
                        Nuestro propósito
                    </a>

                    <!-- Opciones según la sesión -->
                    <% if (usuarioActual) { %>

                        <% if (usuarioActual.rol === 'ciudadano') { %>
                            <!-- Menú ciudadano -->
                            <div class="nav-item dropdown">
                                <button
                                    class="nav-link dropdown-toggle border-0 bg-transparent"
                                    type="button"
                                    id="menuCiudadano"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                >
                                    <i class="bi bi-person-circle me-1"></i>
                                    Mi perfil
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuCiudadano">
                                    <li>
                                        <a class="dropdown-item" href="/ciudadano">
                                            <i class="bi bi-clipboard-check me-2"></i>
                                            Mis participaciones
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form action="/logout" method="POST">
                                            <button class="dropdown-item" type="submit">
                                                <i class="bi bi-box-arrow-right me-2"></i>
                                                Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>

                        <% } else if (usuarioActual.rol === 'empresa') { %>
                            <!-- Menú empresa -->
                            <div class="nav-item dropdown">
                                <button
                                    class="nav-link dropdown-toggle border-0 bg-transparent"
                                    type="button"
                                    id="menuEmpresa"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                >
                                    <i class="bi bi-building me-1"></i>
                                    Mi panel
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuEmpresa">
                                    <li>
                                        <a class="dropdown-item" href="/empresa">
                                            <i class="bi bi-folder2-open me-2"></i>
                                            Mis proyectos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/empresa/crear-proyecto">
                                            <i class="bi bi-plus-circle me-2"></i>
                                            Crear proyecto
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form action="/logout" method="POST">
                                            <button class="dropdown-item" type="submit">
                                                <i class="bi bi-box-arrow-right me-2"></i>
                                                Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>

                        <% } else if (usuarioActual.rol === 'admin') { %>
                            <!-- Menú administrador -->
                            <div class="nav-item dropdown">
                                <button
                                    class="nav-link dropdown-toggle border-0 bg-transparent"
                                    type="button"
                                    id="menuAdmin"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                >
                                    <i class="bi bi-shield-check me-1"></i>
                                    Mi panel
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuAdmin">
                                    <li>
                                        <a class="dropdown-item" href="/admin">
                                            <i class="bi bi-kanban me-2"></i>
                                            Gestionar proyectos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/admin#historial">
                                            <i class="bi bi-clock-history me-2"></i>
                                            Historial
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form action="/logout" method="POST">
                                            <button class="dropdown-item" type="submit">
                                                <i class="bi bi-box-arrow-right me-2"></i>
                                                Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        <% } %>

                    <% } else { %>
                        <!-- Visitante: iniciar sesión -->
                        <a class="nav-link <%= paginaactual === 'login' ? 'active' : '' %>" href="/login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Iniciar sesión
                        </a>

                        <!-- Visitante: crear cuenta -->
                         
                        <!-- <div class="nav-item dropdown">
                            <button
                                class="nav-link dropdown-toggle border-0 bg-transparent"
                                type="button"
                                id="menuCrearCuenta"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                            >
                                <i class="bi bi-person-plus-fill me-1"></i>
                                Crear cuenta
                            </button> -->

                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuCrearCuenta">
                                <li>
                                    <a class="dropdown-item" href="/registro-ciudadano">
                                        <i class="bi bi-person-heart me-2"></i>
                                        Registrarme como ciudadano
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/registro-empresa">
                                        <i class="bi bi-building-add me-2"></i>
                                        Registrar mi empresa
                                    </a>
                                </li>
                            </ul>
                        </div>
                    <% } %>

                </div>
            </div>
        </div>
    </nav>

    <main>