
<%- include('partials/header') %>

<!-- =====================================
     ECOPULSO - REGISTRO DE EMPRESAS
===================================== -->

<section class="eco-registro-pagina py-5">

    <div class="container">

        <div class="eco-registro-diseno">

            <!-- =====================================
                 PANEL DE BIENVENIDA
            ===================================== -->

            <div class="eco-registro-ilustracion">

                <div class="eco-registro-ilustracion-contenido">

                    <span class="eco-registro-etiqueta">
                        <i class="bi bi-leaf-fill me-2"></i>
                        El planeta también tiene voz
                    </span>

                   

                    <div class="eco-registro-mensaje">

                        <h2 class="fw-bold">
                            Tu empresa puede transformar el planeta
                        </h2>

                        <p>
                            Comparte tus iniciativas ambientales,
                            conecta con ciudadanos comprometidos
                            y construyamos juntos
                            un futuro más sostenible.
                        </p>

                    </div>

                </div>

            </div>


            <!-- =====================================
                 PANEL DEL FORMULARIO
            ===================================== -->

            <div class="eco-registro-panel">

                <div class="eco-registro-formulario">

                    <!-- IDENTIDAD DE ECOPULSO -->
                    <div class="eco-registro-encabezado text-center">

                        <div class="eco-registro-logo">
                            <i class="bi bi-leaf-fill"></i>
                        </div>

                        <p class="eco-registro-marca">
                            EcoPulso
                        </p>

                        <p class="eco-registro-lema">
                            Juntos por un mundo más verde
                        </p>

                        <h1 class="fw-bold mt-3">
                            Registro de empresas
                        </h1>

                        <p class="text-muted">
                            Sé parte del cambio y crea
                            proyectos que beneficien
                            a nuestra comunidad.
                        </p>

                    </div>


                    <!-- FORMULARIO -->
                    <form
                        action="/registro-empresa"
                        method="POST"
                    >

                        <!-- NOMBRE DE LA EMPRESA -->
                        <div class="mb-3">

                            <label
                                for="nombre"
                                class="form-label fw-semibold"
                            >
                                <i class="bi bi-building me-2"></i>
                                Nombre de la empresa
                            </label>

                            <input
                                type="text"
                                class="form-control eco-registro-campo"
                                id="nombre"
                                name="nombre"
                                placeholder="Ej. EcoVerde S.A.S."
                                maxlength="120"
                                autocomplete="organization"
                                required
                            >

                        </div>


                        <!-- CORREO EMPRESARIAL -->
                        <div class="mb-3">

                            <label
                                for="correo"
                                class="form-label fw-semibold"
                            >
                                <i class="bi bi-envelope me-2"></i>
                                Correo electrónico empresarial
                            </label>

                            <input
                                type="email"
                                class="form-control eco-registro-campo"
                                id="correo"
                                name="correo"
                                placeholder="contacto@empresa.com"
                                maxlength="254"
                                autocomplete="email"
                                required
                            >

                        </div>


                        <!-- CONTRASEÑA -->
                        <div class="mb-4">

                            <label
                                for="contrasena"
                                class="form-label fw-semibold"
                            >
                                <i class="bi bi-lock me-2"></i>
                                Contraseña
                            </label>

                            <input
                                type="password"
                                class="form-control eco-registro-campo"
                                id="contrasena"
                                name="contrasena"
                                placeholder="Mínimo 12 caracteres"
                                minlength="12"
                                autocomplete="new-password"
                                required
                            >

                            <div class="form-text">
                                Utiliza una contraseña única
                                de al menos 12 caracteres.
                            </div>

                        </div>


                        <!-- BOTÓN DE REGISTRO -->
                        <button
                            type="submit"
                            class="btn btn-eco eco-registro-boton w-100 fw-bold"
                        >
                            <i class="bi bi-building-add me-2"></i>
                            Crear cuenta empresarial
                        </button>

                    </form>


                    <!-- INICIAR SESIÓN -->
                    <div class="eco-registro-acceso text-center">

                        <p class="mb-0">
                            ¿Ya tienes una cuenta?

                            <a
                                href="/login"
                                class="eco-registro-enlace fw-bold"
                            >
                                Iniciar sesión
                            </a>
                        </p>

                    </div>


                    <!-- OTRA MODALIDAD DE REGISTRO -->
                    <p class="eco-registro-alternativa text-center">

                        ¿Quieres participar como ciudadano?

                        <a href="/registro-ciudadano">
                            Crea una cuenta ciudadana
                        </a>

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<%- include('partials/footer') %>
