
<%- include('partials/header') %>

<!-- =====================================
     ECOPULSO - REGISTRO DE CIUDADANOS
===================================== -->

<section class="eco-registro-pagina py-5">

    <div class="container">

        <div class="eco-registro-diseno">

            <!-- =====================================
                 PANEL DE BIENVENIDA
            ===================================== -->

            <div class="eco-registro-ilustracion">

                <div class="eco-registro-ilustracion-contenido">

                    <span class="eco-registro-etiqueta">
                        <i class="bi bi-heart-fill me-2"></i>
                        El planeta también tiene voz
                    </span>

                

                    <div class="eco-registro-mensaje">

                        <h2 class="fw-bold">
                            ¡Tu voz puede cambiar el mundo!
                        </h2>

                        <p>
                            Únete a nuestra comunidad,
                            participa en proyectos ambientales
                            y ayúdanos a construir
                            un planeta más verde.
                        </p>

                    </div>

                </div>

            </div>


            <!-- =====================================
                 PANEL DEL FORMULARIO
            ===================================== -->

            <div class="eco-registro-panel">

                <div class="eco-registro-formulario">

                    <!-- IDENTIDAD DE ECOPULSO -->
                    <div class="eco-registro-encabezado text-center">

                        <div class="eco-registro-logo">
                            <i class="bi bi-leaf-fill"></i>
                        </div>

                        <p class="eco-registro-marca">
                            EcoPulso
                        </p>

                        <p class="eco-registro-lema">
                            Juntos por un mundo más verde
                        </p>

                        <h1 class="fw-bold mt-3">
                            Registro de ciudadanos
                        </h1>

                        <p class="text-muted">
                            Crea tu cuenta y comienza a formar
                            parte del cambio ambiental.
                        </p>

                    </div>


                    <!-- FORMULARIO -->
                    <form
                        action="/registro-ciudadano"
                        method="POST"
                    >

                        <!-- NOMBRE COMPLETO -->
                        <div class="mb-3">

                            <label
                                for="nombre"
                                class="form-label fw-semibold"
                            >
                                <i class="bi bi-person me-2"></i>
                                Nombre completo
                            </label>

                            <input
                                type="text"
                                class="form-control eco-registro-campo"
                                id="nombre"
                                name="nombre"
                                placeholder="Escribe tu nombre completo"
                                maxlength="120"
                                autocomplete="name"
                                required
                            >

                        </div>


                        <!-- CORREO ELECTRÓNICO -->
                        <div class="mb-3">

                            <label
                                for="correo"
                                class="form-label fw-semibold"
                            >
                                <i class="bi bi-envelope me-2"></i>
                                Correo electrónico
                            </label>

                            <input
                                type="email"
                                class="form-control eco-registro-campo"
                                id="correo"
                                name="correo"
                                placeholder="correo@ejemplo.com"
                                maxlength="254"
                                autocomplete="email"
                                required
                            >

                        </div>


                        <!-- CONTRASEÑA -->
                        <div class="mb-4">

                            <label
                                for="contrasena"
                                class="form-label fw-semibold"
                            >
                                <i class="bi bi-lock me-2"></i>
                                Contraseña
                            </label>

                            <input
                                type="password"
                                class="form-control eco-registro-campo"
                                id="contrasena"
                                name="contrasena"
                                placeholder="Mínimo 12 caracteres"
                                minlength="12"
                                autocomplete="new-password"
                                required
                            >

                            <div class="form-text">
                                Utiliza una contraseña única
                                de al menos 12 caracteres.
                            </div>

                        </div>


                        <!-- BOTÓN DE REGISTRO -->
                        <button
                            type="submit"
                            class="btn btn-eco eco-registro-boton w-100 fw-bold"
                        >
                            <i class="bi bi-person-check-fill me-2"></i>
                            Crear mi cuenta
                        </button>

                    </form>


                    <!-- INICIAR SESIÓN -->
                    <div class="eco-registro-acceso text-center">

                        <p class="mb-0">
                            ¿Ya tienes una cuenta?

                            <a
                                href="/login"
                                class="eco-registro-enlace fw-bold"
                            >
                                Iniciar sesión
                            </a>
                        </p>

                    </div>


                    <!-- OTRA MODALIDAD DE REGISTRO -->
                    <p class="eco-registro-alternativa text-center">

                        ¿Representas una empresa?

                        <a href="/registro-empresa">
                            Registra tu empresa
                        </a>

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<%- include('partials/footer') %>
