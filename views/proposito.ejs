
<%- include('partials/header') %>

<!-- =====================================
     ECOPULSO - NUESTRO PROPÓSITO
===================================== -->

<!-- =====================================
     ENCABEZADO DE NUESTRO PROPÓSITO
===================================== -->

<section class="eco-proposito-hero py-5 text-center">
    <div class="container">

        <span class="eco-proposito-etiqueta">
            <i class="bi bi-heart-fill me-2"></i>
            El planeta también tiene voz
        </span>

        <h1 class="display-5 fw-bold mt-3">
            Nuestro propósito
        </h1>

        <p class="lead mx-auto mt-3 eco-proposito-descripcion">
            Creemos que cuidar el planeta comienza
            cuando aprendemos a escuchar nuestro entorno
            y decidimos actuar juntos para protegerlo.
        </p>

    </div>
</section>


<!-- =====================================
     PRESENTACIÓN DE ECOPULSO
===================================== -->

<section class="py-5">
    <div class="container">

        <div class="row align-items-center g-5">

            <!-- PRESENTACIÓN -->
            <div class="col-lg-6">

                <span class="eco-proposito-subtitulo">
                    <i class="bi bi-globe-americas me-2"></i>
                    Conoce EcoPulso
                </span>

                <h2 class="fw-bold mt-3 eco-proposito-titulo">
                    Una voz para nuestro planeta
                </h2>

                <p class="mt-3">
                    EcoPulso es una plataforma digital que conecta
                    a empresas comprometidas con el medio ambiente
                    y ciudadanos que desean contribuir al cuidado
                    de su comunidad.
                </p>

                <p>
                    A través de proyectos ambientales,
                    EcoMapa y EcoJornadas, promovemos
                    iniciativas que protegen nuestros
                    recursos naturales y ofrecen
                    oportunidades reales de participación.
                </p>

                <!-- BOTÓN HACIA ECOMAPA -->
                <a
                    href="/ecomapa"
                    class="btn btn-eco mt-3"
                >
                    <i class="bi bi-megaphone-fill me-2"></i>
                    Haz escuchar tu voz
                </a>

            </div>


            <!-- ILUSTRACIÓN -->
            <div class="col-lg-6 text-center">

                <div class="eco-proposito-ilustracion">

                    <i class="bi bi-globe-americas"></i>

                    <h3 class="fw-bold mt-3">
                        Un planeta, muchas voces
                    </h3>

                    <p class="mb-0">
                        Cada acción cuenta para construir
                        un futuro más sostenible.
                    </p>

                </div>

            </div>

        </div>

    </div>
</section>


<!-- =====================================
     MISIÓN, VISIÓN Y VALORES
===================================== -->

<section class="eco-proposito-valores py-5">
    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold eco-proposito-titulo">
                Lo que nos inspira
            </h2>

            <p class="text-muted">
                Nuestros principios para impulsar
                una comunidad comprometida con el ambiente.
            </p>

        </div>


        <div class="row g-4">

            <!-- =====================================
                 NUESTRA MISIÓN
            ===================================== -->

            <div class="col-md-4">

                <div class="card eco-proposito-card h-100 border-0 shadow-sm">

                    <div class="card-body p-4 text-center">

                        <div class="eco-proposito-icono proposito-mision mx-auto mb-4">
                            <i class="bi bi-bullseye"></i>
                        </div>

                        <h3 class="h4 fw-bold">
                            Nuestra misión
                        </h3>

                        <p class="mt-3 mb-0">
                            Facilitar la creación de proyectos
                            ambientales y promover la participación
                            ciudadana mediante herramientas digitales
                            que conecten a empresas y comunidades
                            para cuidar nuestro entorno.
                        </p>

                    </div>

                </div>

            </div>


            <!-- =====================================
                 NUESTRA VISIÓN
            ===================================== -->

            <div class="col-md-4">

                <div class="card eco-proposito-card h-100 border-0 shadow-sm">

                    <div class="card-body p-4 text-center">

                        <div class="eco-proposito-icono proposito-vision mx-auto mb-4">
                            <i class="bi bi-eye-fill"></i>
                        </div>

                        <h3 class="h4 fw-bold">
                            Nuestra visión
                        </h3>

                        <p class="mt-3 mb-0">
                            Ser una plataforma que inspire
                            la colaboración entre empresas
                            y ciudadanos, impulsando proyectos
                            que contribuyan a la protección
                            del agua, los ecosistemas
                            y los recursos naturales.
                        </p>

                    </div>

                </div>

            </div>


            <!-- =====================================
                 NUESTROS VALORES
            ===================================== -->

            <div class="col-md-4">

                <div class="card eco-proposito-card h-100 border-0 shadow-sm">

                    <div class="card-body p-4 text-center">

                        <div class="eco-proposito-icono proposito-valores mx-auto mb-4">
                            <i class="bi bi-heart-fill"></i>
                        </div>

                        <h3 class="h4 fw-bold">
                            Nuestros valores
                        </h3>

                        <p class="mt-3 mb-0">
                            Responsabilidad ambiental,
                            respeto por la naturaleza,
                            participación comunitaria,
                            solidaridad y compromiso
                            con las futuras generaciones.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>


<!-- =====================================
     COMPROMISO CON EL ODS 6
===================================== -->

<section class="eco-proposito-ods py-5">
    <div class="container">

        <div class="row align-items-center g-4">

            <!-- ICONO DEL ODS -->
            <div class="col-lg-4 text-center">

                <div class="eco-proposito-ods-icono">

                    <i class="bi bi-droplet-fill"></i>

                    <span>
                        ODS 6
                    </span>

                </div>

            </div>


            <!-- INFORMACIÓN DEL ODS -->
            <div class="col-lg-8">

                <span class="eco-proposito-subtitulo">
                    Nuestro compromiso ambiental
                </span>

                <h2 class="fw-bold mt-3">
                    Agua limpia y saneamiento
                </h2>

                <p class="mt-3">
                    El Objetivo de Desarrollo Sostenible 6
                    busca garantizar la disponibilidad
                    de agua, su gestión sostenible
                    y el saneamiento para todas las personas.
                </p>

                <p class="mb-0">
                    En EcoPulso contribuimos a promover
                    este objetivo mediante proyectos
                    ambientales, iniciativas de protección
                    de las fuentes hídricas y oportunidades
                    para que los ciudadanos participen
                    activamente en el cuidado de su entorno.
                </p>

            </div>

        </div>

    </div>
</section>


<!-- =====================================
     INVITACIÓN FINAL
===================================== -->

<section class="eco-proposito-invitacion py-5 text-center">
    <div class="container">

        <i class="bi bi-leaf-fill eco-proposito-hoja"></i>

        <h2 class="fw-bold mt-3">
            Tu voz puede transformar el entorno
        </h2>

        <p class="mx-auto eco-proposito-invitacion-texto">
            Tú también puedes formar parte del cambio.
            Explora los proyectos ambientales de tu comunidad,
            descubre dónde se desarrollan y encuentra
            una oportunidad para participar en
            la protección de la naturaleza.
        </p>

        <!-- BOTONES DE PARTICIPACIÓN -->
        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">

            <a
                href="/ecomapa"
                class="btn btn-eco btn-lg"
            >
                <i class="bi bi-geo-alt-fill me-2"></i>
                Explorar EcoMapa
            </a>

            <a
                href="/ecojornadas"
                class="btn btn-outline-success btn-lg"
            >
                <i class="bi bi-people-fill me-2"></i>
                Participar en EcoJornadas
            </a>

        </div>

    </div>
</section>

